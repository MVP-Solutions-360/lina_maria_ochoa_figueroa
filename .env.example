# Copia este archivo a ".env" en el VPS (el ".env" real NO se versiona) y ajusta los valores.
# No hay secretos: solo dónde publica Docker el puerto del contenedor en el host.

# Dirección del host en la que escucha el contenedor. Debe ser la IP a la que apunta el proxy
# host de Nginx Proxy Manager (hoy: http://172.17.0.1:3005). 172.17.0.1 es la puerta de enlace
# habitual de la red "bridge" de Docker, pero CONFÍRMALA en el VPS (ver docs/deployment.md, paso 2).
# No uses 0.0.0.0: expondría el puerto 3005 directamente a Internet, saltándose Nginx Proxy Manager.
LINA_BIND_IP=172.17.0.1

# Puerto del host (el interno del contenedor es siempre 80).
LINA_HOST_PORT=3005
